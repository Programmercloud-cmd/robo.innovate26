# ---------------------------------------------------------------
# Runtime recordings / telemetry (≈2.8 GB, regenerated on every run)
# ---------------------------------------------------------------
# Live digital-twin telemetry (telemetry.ndjson alone is ~2.5 GB)
digital_twin/runs/
# Per-run controller/trajectory dumps
teaching/*/runs/
# Per-command motion records written by the teaching tools
teaching/moves/
teaching/gripper_moves/
# Planner path cache (recreated automatically by factory_cycle/planner.py)
teaching/factory_cycle/cache/

